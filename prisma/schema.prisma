generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPERADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum BanType {
  TEMPORARY
  PERMANENT
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  role              Role      @default(USER)
  minecraftUUID     String?   @unique
  minecraftUsername String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  tickets          Ticket[]
  ticketMessages   TicketMessage[]
  voteHistory      VoteHistory[]
  notifications    Notification[]
  referrals        Referral[]      @relation("Referrer")
  referredBy       Referral?       @relation("Referred")
  auditLogs        AuditLog[]
}

model PlayerProfile {
  id           String   @id @default(cuid())
  uuid         String   @unique
  username     String   @unique
  rank         String   @default("DEFAULT")
  balance      Float    @default(0)
  islandName   String?
  islandLevel  Int      @default(0)
  islandValue  Float    @default(0)
  skillLevel   Int      @default(0)
  playtime     Int      @default(0)
  voteCount    Int      @default(0)
  achievements Int      @default(0)
  lastSeen     DateTime?
  isOnline     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stats PlayerStats?
}

model PlayerStats {
  id              String        @id @default(cuid())
  playerId        String        @unique
  blocksPlaced    Int           @default(0)
  blocksBroken    Int           @default(0)
  mobsKilled      Int           @default(0)
  deaths          Int           @default(0)
  craftedItems    Int           @default(0)
  questsCompleted Int           @default(0)
  dungeonsCleared Int           @default(0)
  totalXP         BigInt        @default(0)
  prestige        Int           @default(0)
  player          PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Float
  originalPrice Float?
  category      String
  imageUrl      String?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  status        OrderStatus @default(PENDING)
  total         Float
  currency      String      @default("IDR")
  paymentMethod String?
  paymentRef    String?
  notes         String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int     @default(1)
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model VoteSite {
  id        String        @id @default(cuid())
  name      String
  url       String
  reward    String?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  votes     VoteHistory[]
}

model VoteHistory {
  id       String   @id @default(cuid())
  userId   String
  siteId   String
  votedAt  DateTime @default(now())
  rewarded Boolean  @default(false)
  user     User     @relation(fields: [userId], references: [id])
  site     VoteSite @relation(fields: [siteId], references: [id])
}

model Ticket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  category  String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  isStaff   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  category    String
  imageUrl    String?
  isPublished Boolean   @default(false)
  viewCount   Int       @default(0)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  rewarded   Boolean  @default(false)
  createdAt  DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referred User @relation("Referred", fields: [referredId], references: [id])
}

model BannedPlayer {
  id        String    @id @default(cuid())
  uuid      String?
  username  String?
  ip        String?
  reason    String
  banType   BanType   @default(PERMANENT)
  expiresAt DateTime?
  bannedBy  String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model WikiPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  category    String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffMember {
  id            String   @id @default(cuid())
  username      String
  minecraftUUID String?
  role          String
  description   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
}

model StaffApplication {
  id                String   @id @default(cuid())
  minecraftUsername String
  discordUsername   String
  age               Int?
  timezone          String?
  experience        String
  whyJoin           String
  availability      String?
  status            String   @default("PENDING")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BugReport {
  id                String   @id @default(cuid())
  minecraftUsername String?
  discordUsername   String?
  category          String
  title             String
  description       String
  stepsToReproduce  String?
  severity          String   @default("MEDIUM")
  status            String   @default("OPEN")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ChangelogEntry {
  id          String   @id @default(cuid())
  version     String
  title       String
  description String
  type        String   @default("UPDATE")
  changes     Json
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model IslandShowcase {
  id            String   @id @default(cuid())
  ownerUsername String
  ownerUUID     String?
  islandName    String
  description   String?
  imageUrl      String?
  islandLevel   Int      @default(0)
  islandValue   Float    @default(0)
  votes         Int      @default(0)
  isFeatured    Boolean  @default(false)
  month         Int
  year          Int
  createdAt     DateTime @default(now())
}
